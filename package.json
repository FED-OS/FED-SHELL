{
  "name": "fed-shell",
  "version": "1.0.0",
  "description": "Wraps a website into native apps for every platform using Capacitor (mobile), Electron (desktop), and Tauri (native macOS), built automatically via GitHub Actions.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder -mwl --publish never",
    "build": "electron-builder",
    "make": "electron-builder",
    "sync": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "build:apk": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:tv": "npx cap sync android && cd android && ./gradlew assembleDebug -PandroidTv=true",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "capacitor",
    "electron",
    "tauri",
    "android",
    "apk",
    "webview",
    "desktop",
    "ios",
    "tv",
    "tablet",
    "macos"
  ],
  "author": "FED-OS / Fedpromptly",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@tauri-apps/cli": "^2"
  },
  "build": {
    "appId": "com.fed.shell",
    "productName": "FED Shell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "extensions/**/*",
      "config.json",
      "www/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "category": "Utility"
    }
  }
}
