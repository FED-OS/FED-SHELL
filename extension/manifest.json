{
  "manifest_version": 3,
  "name": "web2apk — Web App Launcher",
  "short_name": "web2apk",
  "version": "2.1.0",
  "description": "Turn any website into an app — one-click app windows, a new-tab dashboard, quick links, and status badges. For Chrome & Edge.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "web2apk — open your web app",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": ["storage", "alarms", "contextMenus"],
  "commands": {
    "open-app-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Open the configured web app in an app window"
    },
    "open-dashboard": {
      "description": "Open the web2apk dashboard"
    }
  },
  "offline_enabled": true,
  "author": "web2apk contributors",
  "homepage_url": "https://github.com/FED-OS/Build-Mobile-Apps-Android-iOS"
}
